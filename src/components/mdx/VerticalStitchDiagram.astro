---
interface Step {
  title: string;
  detail: string;
}

interface Props {
  label: string;
  steps: [Step, Step, Step];
}

const { label, steps } = Astro.props;
const columns = [
  ['漢', '字', 'を', '読', 'む'],
  ['前', 'に', '強', 'い'],
];
---

<figure class="not-prose my-8" aria-label={label}>
  <ol class="m-0 flex list-none flex-col items-stretch gap-2 p-0 md:flex-row md:gap-6">
    {
      steps.map((step, index) => (
        <li class="relative flex flex-col items-center gap-2 md:min-w-0 md:flex-1">
          <div class="flex w-full flex-1 flex-col rounded-2xl border border-line bg-white p-4">
            <div
              class="flex h-40 items-center justify-center rounded-xl bg-zinc-100 font-medium text-ink"
              aria-hidden="true"
            >
              {index === 0 && (
                <div class="flex flex-row-reverse gap-3 text-lg leading-none">
                  {columns.map((column) => (
                    <div class="flex flex-col gap-1">
                      {column.map((char) => (
                        <span>{char}</span>
                      ))}
                    </div>
                  ))}
                </div>
              )}
              {index === 1 && (
                <div class="flex flex-row-reverse gap-2 text-base leading-none">
                  {columns.map((column) => (
                    <div class="flex flex-col gap-0.5 rounded-lg border border-zinc-400 p-1">
                      {column.map((char) => (
                        <span class="flex size-6 items-center justify-center rounded border border-dashed border-zinc-500 bg-white">
                          {char}
                        </span>
                      ))}
                    </div>
                  ))}
                </div>
              )}
              {index === 2 && (
                <div class="flex items-center rounded-lg border border-zinc-400 bg-white px-1.5 py-1 text-sm leading-none">
                  {columns.map((column, columnIndex) => (
                    <>
                      {columnIndex > 0 && <span class="mx-1 h-5 w-px bg-zinc-400" />}
                      {column.map((char) => (
                        <span class="px-px">{char}</span>
                      ))}
                    </>
                  ))}
                </div>
              )}
            </div>
            <span class="mt-3 block text-xs font-semibold text-muted">
              {String(index + 1).padStart(2, '0')}
            </span>
            <strong class="mt-1 block text-sm text-ink">{step.title}</strong>
            <span class="mt-1 block text-sm leading-6 text-muted">{step.detail}</span>
          </div>
          {index < steps.length - 1 && (
            <span
              class="flex shrink-0 items-center justify-center text-muted md:absolute md:top-1/2 md:-right-[1.125rem] md:w-3 md:-translate-y-1/2"
              aria-hidden="true"
            >
              <span class="md:hidden">↓</span>
              <span class="hidden md:inline">→</span>
            </span>
          )}
        </li>
      ))
    }
  </ol>
  <figcaption class="mt-3 text-sm leading-6 text-muted">{label}</figcaption>
</figure>
