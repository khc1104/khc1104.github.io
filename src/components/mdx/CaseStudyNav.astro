---
interface Item {
  href: string;
  label: string;
}

interface Props {
  label: string;
  items: Item[];
}

const { label, items } = Astro.props;
---

<nav class="not-prose my-8 rounded-2xl border border-line bg-white p-4" aria-label={label}>
  <p class="text-sm font-semibold text-ink">{label}</p>
  <ol class="mt-3 grid list-none gap-1 p-0 sm:grid-cols-2">
    {
      items.map((item, index) => (
        <li>
          <a
            class="flex min-h-11 items-center gap-3 rounded-xl px-3 py-2 text-sm text-muted outline-none hover:bg-zinc-100 hover:text-ink focus-visible:ring-2 focus-visible:ring-zinc-700"
            href={item.href}
          >
            <span class="text-xs font-semibold text-muted">
              {String(index + 1).padStart(2, '0')}
            </span>
            {item.label}
          </a>
        </li>
      ))
    }
  </ol>
</nav>
