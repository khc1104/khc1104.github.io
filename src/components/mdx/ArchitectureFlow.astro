---
interface Step {
  title: string;
  detail?: string;
}

interface Props {
  label: string;
  steps: Step[];
}

const { label, steps } = Astro.props;
---

<figure class="not-prose my-8" aria-label={label}>
  <ol class="flex flex-col gap-2 md:flex-row md:overflow-x-auto md:pb-2">
    {
      steps.map((step, index) => (
        <li class="relative rounded-2xl border border-line bg-white p-4 md:min-w-52 md:flex-1">
          <span class="text-xs font-semibold text-muted">{String(index + 1).padStart(2, '0')}</span>
          <strong class="mt-2 block text-sm text-ink">{step.title}</strong>
          {step.detail && <span class="mt-1 block text-sm leading-6 text-muted">{step.detail}</span>}
          {
            index < steps.length - 1 && (
              <>
                <span class="mt-3 block text-center text-muted md:hidden" aria-hidden="true">↓</span>
                <span
                  class="absolute top-1/2 -right-2.5 z-10 hidden -translate-y-1/2 bg-paper px-1 text-muted md:block"
                  aria-hidden="true"
                >
                  →
                </span>
              </>
            )
          }
        </li>
      ))
    }
  </ol>
  <figcaption class="mt-3 text-sm leading-6 text-muted">{label}</figcaption>
</figure>
