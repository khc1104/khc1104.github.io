---
interface Step {
  title: string;
  detail?: string;
}

interface Props {
  label: string;
  steps: Step[];
}

const { label, steps } = Astro.props;
---

<figure class="not-prose my-8" aria-label={label}>
  <ol class="m-0 flex list-none flex-col items-stretch gap-2 p-0 md:grid md:grid-cols-3 md:gap-x-6 md:gap-y-4">
    {
      steps.map((step, index) => (
        <li class="relative flex flex-col items-center gap-2 md:items-stretch">
          <div class="w-full flex-1 rounded-2xl border border-line bg-white p-4">
            <span class="block text-xs font-semibold text-muted">
              {String(index + 1).padStart(2, '0')}
            </span>
            <strong class="mt-2 block text-sm text-ink">{step.title}</strong>
            {step.detail && <span class="mt-1 block text-sm leading-6 text-muted">{step.detail}</span>}
          </div>
          {index < steps.length - 1 && (
            <span
              class:list={[
                'flex shrink-0 items-center justify-center text-muted md:absolute md:top-1/2 md:-right-[1.125rem] md:w-3 md:-translate-y-1/2',
                index % 3 === 2 && 'md:hidden',
              ]}
              aria-hidden="true"
            >
              <span class="md:hidden">↓</span>
              <span class="hidden md:inline">→</span>
            </span>
          )}
        </li>
      ))
    }
  </ol>
  <figcaption class="mt-3 text-sm leading-6 text-muted">{label}</figcaption>
</figure>
