---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<aside class="not-prose my-6 rounded-2xl border border-line bg-zinc-100 px-4 py-4" aria-label={label}>
  <p class="text-sm font-semibold text-ink">{label}</p>
  <div class="mt-2 text-sm leading-7 text-muted">
    <slot />
  </div>
</aside>
