---
import type { HistoryItem } from '../data/profile';

interface Props {
  title: string;
  items: HistoryItem[];
}

const { title, items } = Astro.props;
---

<div class="space-y-3">
  <h3 class="text-sm font-semibold text-ink">{title}</h3>
  <ol class="divide-y divide-line rounded-2xl border border-line bg-white">
    {
      items.map((item) => (
        <li class="grid gap-1 px-4 py-3 sm:grid-cols-[10rem_minmax(0,1fr)] sm:gap-4">
          <span class="text-sm tabular-nums text-muted">{item.period}</span>
          <div class="min-w-0 space-y-1">
            <p class="text-sm font-medium text-ink">
              {item.title}
              {item.role && <span class="font-normal text-muted"> · {item.role}</span>}
            </p>
            {item.summary && <p class="text-sm leading-6 text-muted">{item.summary}</p>}
          </div>
        </li>
      ))
    }
  </ol>
</div>
