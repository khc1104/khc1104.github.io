---
import DevicePreview from './DevicePreview.astro';
import TechBadge from './TechBadge.astro';
import type { ProjectPlatform } from '../lib/platform';

interface Props {
  title: string;
  summary: string;
  stack: string[];
  href: string;
  platform: ProjectPlatform;
  platformLabel: string;
  screenshotSrc?: string;
  screenshotAlt: string;
}

const {
  title,
  summary,
  stack,
  href,
  platform,
  platformLabel,
  screenshotSrc,
  screenshotAlt,
} = Astro.props;

const frameClass = platform === 'web' ? 'w-40 sm:w-52' : 'w-28 sm:w-32';
---

<a
  class="block rounded-2xl border border-line bg-white p-5 transition-colors hover:border-zinc-400"
  href={href}
>
  <article class="flex flex-col gap-4 sm:flex-row sm:items-start">
    <DevicePreview
      class={frameClass}
      platform={platform}
      src={screenshotSrc}
      alt={screenshotAlt}
    />
    <div class="min-w-0 flex-1 space-y-3">
      <p class="text-xs font-medium tracking-wide text-muted">{platformLabel}</p>
      <h3 class="text-lg font-semibold tracking-tight">{title}</h3>
      <p class="text-sm text-muted">{summary}</p>
      <div class="flex flex-wrap gap-1.5">
        {stack.map((label) => <TechBadge label={label} />)}
      </div>
    </div>
  </article>
</a>
