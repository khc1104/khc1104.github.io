---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  alt: string;
  monogram: string;
  class?: string;
}

const { alt, monogram, class: className } = Astro.props;

const photos = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/profile.{jpg,jpeg,png,webp}',
  { eager: true },
);
const photo = Object.values(photos)[0]?.default;
const frame =
  'relative aspect-[3/4] w-36 shrink-0 overflow-hidden rounded-2xl border border-line sm:aspect-auto sm:min-h-56 sm:w-60';
---

{
  photo ? (
    <div class:list={[frame, className]}>
      <Image
        class="absolute inset-0 h-full w-full object-cover object-[50%_70%]"
        src={photo}
        alt={alt}
        widths={[288, 480, 576]}
        sizes="(min-width: 640px) 240px, 144px"
        loading="eager"
      />
    </div>
  ) : (
    <div
      class:list={[frame, 'flex items-center justify-center bg-zinc-100', className]}
      role="img"
      aria-label={alt}
    >
      <span class="text-4xl font-semibold text-zinc-500 sm:text-5xl" aria-hidden="true">
        {monogram}
      </span>
    </div>
  )
}
