---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Lang } from '../i18n/ui';
import { otherLang, useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const next = otherLang(lang);
const homeHref = getRelativeLocaleUrl(lang, '/');
const switchHref = getRelativeLocaleUrl(next, '/');
---

<header class="border-b border-line bg-white">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-4">
    <a class="font-semibold tracking-tight" href={homeHref}>{t('siteName')}</a>
    <nav class="flex items-center gap-4 text-sm">
      <a class="text-muted hover:text-ink" href={homeHref}>{t('navHome')}</a>
      <a class="text-muted hover:text-ink" href="#projects">{t('navProjects')}</a>
      <a
        class="rounded-full border border-zinc-300 px-3 py-1 text-zinc-700 hover:border-zinc-500"
        href={switchHref}
        hreflang={next}
        lang={next}
      >
        {t('langSwitch')}
      </a>
    </nav>
  </div>
</header>
