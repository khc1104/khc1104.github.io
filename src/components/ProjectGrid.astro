---
import ProjectCard from './ProjectCard.astro';
import type { Lang } from '../i18n/ui';
import type { PlaceholderProject } from '../data/placeholder-projects';

interface Props {
  lang: Lang;
  projects: PlaceholderProject[];
  emptyLabel: string;
  targetLabel: string;
  screenshotAlt: string;
}

const { lang, projects, emptyLabel, targetLabel, screenshotAlt } = Astro.props;
---

{
  projects.length === 0 ? (
    <p class="text-muted">{emptyLabel}</p>
  ) : (
    <div class="grid gap-5 md:grid-cols-2">
      {projects.map((project) => (
        <ProjectCard
          title={project.title[lang]}
          summary={project.summary[lang]}
          stack={project.stack}
          targets={project.targets}
          screenshotAlt={screenshotAlt}
          targetLabel={targetLabel}
        />
      ))}
    </div>
  )
}
