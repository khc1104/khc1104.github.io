---
import { getRelativeLocaleUrl } from 'astro:i18n';
import ProjectCard from './ProjectCard.astro';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import {
  firstScreenshot,
  mockupAltKey,
  platformLabelKey,
  projectSlug,
  type ProjectEntry,
} from '../lib/projects';

interface Props {
  lang: Lang;
  projects: ProjectEntry[];
  emptyLabel: string;
}

const { lang, projects, emptyLabel } = Astro.props;
const t = useTranslations(lang);
---

{
  projects.length === 0 ? (
    <p class="text-muted">{emptyLabel}</p>
  ) : (
    <div class="grid gap-5 md:grid-cols-2">
      {projects.map((project) => {
        const shot = firstScreenshot(project);
        const slug = projectSlug(project.id);
        const platform = project.data.platform;
        return (
          <ProjectCard
            title={project.data.title}
            summary={project.data.summary}
            stack={project.data.stack}
            href={getRelativeLocaleUrl(lang, `/projects/${slug}`)}
            platform={platform}
            platformLabel={t(platformLabelKey(platform))}
            screenshotSrc={shot?.src}
            screenshotAlt={shot?.alt ?? t(mockupAltKey(platform))}
          />
        );
      })}
    </div>
  )
}
