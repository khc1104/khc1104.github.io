---
import { getRelativeLocaleUrl } from 'astro:i18n';
import ProjectCard from './ProjectCard.astro';
import type { Lang } from '../i18n/ui';
import { firstScreenshot, projectSlug, type ProjectEntry } from '../lib/projects';

interface Props {
  lang: Lang;
  projects: ProjectEntry[];
  emptyLabel: string;
  targetLabel: string;
  screenshotAlt: string;
}

const { lang, projects, emptyLabel, targetLabel, screenshotAlt } = Astro.props;
---

{
  projects.length === 0 ? (
    <p class="text-muted">{emptyLabel}</p>
  ) : (
    <div class="grid gap-5 md:grid-cols-2">
      {projects.map((project) => {
        const shot = firstScreenshot(project);
        const slug = projectSlug(project.id);
        return (
          <ProjectCard
            title={project.data.title}
            summary={project.data.summary}
            stack={project.data.stack}
            targets={project.data.targets}
            href={getRelativeLocaleUrl(lang, `/projects/${slug}`)}
            screenshotSrc={shot?.src}
            screenshotAlt={shot?.alt ?? screenshotAlt}
            targetLabel={targetLabel}
          />
        );
      })}
    </div>
  )
}
