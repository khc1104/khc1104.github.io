---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import PdfSheet from './PdfSheet.astro';
import PdfMiniPhone from './PdfMiniPhone.astro';
import { pdfUiCopy, type PdfSingleData } from '../../data/pdfPortfolio';
import type { Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { platformLabelKey, type ProjectEntry } from '../../lib/projects';

interface Props {
  lang: Lang;
  entry: ProjectEntry;
  data: PdfSingleData;
  siteUrl: string;
}

const { lang, entry, data, siteUrl } = Astro.props;
const t = useTranslations(lang);
const copy = pdfUiCopy[lang];
const { title, summary, period, role, stack, links, platform } = entry.data;
const webProjectUrl = `${siteUrl}/${lang}/projects/${data.slug}/`;

const allAssets = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/projects/*/*.{png,jpg,jpeg,webp}',
  { eager: true },
);

async function resolveAsset(file?: string): Promise<string | undefined> {
  if (!file) return undefined;
  const found = Object.entries(allAssets).find(([path]) =>
    path.endsWith(`/projects/${data.slug}/${file}`),
  );
  if (!found) return undefined;
  const img = await getImage({ src: found[1].default, width: 480 });
  return img.src;
}

const resolvedScreens = data.screens
  ? await Promise.all(
      data.screens.map(async (item) => ({
        src: item.publicSrc ?? (await resolveAsset(item.assetFile)) ?? '',
        alt: item.alt,
        caption: item.caption,
      })),
    )
  : [];

const phoneSize = resolvedScreens.length <= 3 ? 'md' : 'sm';
---

<PdfSheet lang={lang} kind="detail" projectSlug={data.slug} pagePart="1" siteUrl={siteUrl}>
  <!-- Header -->
  <header class="flex items-start justify-between gap-4 border-b border-line pb-3">
    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-center gap-2 text-[10px] font-medium text-muted">
        <span class="rounded bg-zinc-900 px-1.5 py-0.5 font-semibold text-white">
          {t(platformLabelKey(platform))}
        </span>
        {period && <span class="tabular-nums">{period}</span>}
        {role && <span>· {role}</span>}
      </div>
      <div class="mt-1 flex flex-wrap items-baseline gap-x-3 gap-y-0.5">
        <h1 class="text-[22px] font-bold leading-tight tracking-tight text-ink">{title}</h1>
        <p class="text-[11.5px] text-muted">{summary}</p>
      </div>
    </div>

    <div class="flex max-w-[320px] shrink-0 flex-col items-end gap-1.5">
      <div class="flex flex-wrap justify-end gap-1">
        {stack.map((tech) => (
          <span class="rounded-md border border-line bg-zinc-50 px-1.5 py-0.5 text-[9.5px] font-medium text-ink">
            {tech}
          </span>
        ))}
      </div>
      <div class="flex flex-wrap justify-end gap-2.5 text-[10px] font-medium text-ink">
        {links?.github && (
          <a href={links.github} class="underline underline-offset-2">
            {t('githubLabel')} ↗
          </a>
        )}
        {links?.store && (
          <a href={links.store} class="underline underline-offset-2">
            {t('storeLabel')} ↗
          </a>
        )}
        {links?.demo && (
          <a href={links.demo} class="underline underline-offset-2">
            {t('demoLabel')} ↗
          </a>
        )}
        <a href={webProjectUrl} class="underline underline-offset-2">
          {copy.webDetailLink}
        </a>
      </div>
    </div>
  </header>

  <!-- Main 2-column Body -->
  <div class="mt-4 grid min-h-0 flex-1 grid-cols-[0.95fr_1.25fr] gap-4">
    <!-- Left Column: Overview + Role + Highlight -->
    <div class="flex min-h-0 flex-col justify-between gap-3">
      <div class="space-y-3">
        <section class="rounded-xl border border-line bg-white p-3.5">
          <h2 class="text-[11.5px] font-bold tracking-tight text-ink">{data.overviewTitle}</h2>
          <p class="mt-1.5 text-[11px] leading-[1.6] text-muted">{data.overviewBody}</p>
        </section>

        <section class="rounded-xl border border-line bg-white p-3.5">
          <h2 class="text-[11.5px] font-bold tracking-tight text-ink">{data.roleTitle}</h2>
          <ul class="mt-2 space-y-2 text-[10.5px] leading-[1.55] text-muted">
            {data.roleBullets.map((bullet) => (
              <li class="flex items-start gap-2">
                <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-zinc-900" aria-hidden="true" />
                <span>{bullet}</span>
              </li>
            ))}
          </ul>
        </section>
      </div>

      <div class="space-y-2">
        <div class="rounded-r-xl border-l-2 border-zinc-900 bg-zinc-50 px-3.5 py-2.5">
          <span class="text-[10px] font-bold text-ink">{data.highlightLabel}</span>
          <p class="mt-1 text-[10.5px] leading-[1.5] text-muted">{data.highlightBody}</p>
        </div>
        {data.note && (
          <p class="text-[9.5px] leading-[1.45] text-muted">{data.note}</p>
        )}
      </div>
    </div>

    <!-- Right Column: Screens OR Architecture Modules -->
    {resolvedScreens.length > 0 ? (
      <section class="flex min-h-0 flex-col justify-between rounded-xl border border-line bg-zinc-50/70 p-4">
        <h2 class="text-[11.5px] font-bold tracking-tight text-ink">{data.screensTitle}</h2>
        <div class="flex flex-1 items-center justify-around gap-3 py-2">
          {resolvedScreens.map((screen) => (
            <PdfMiniPhone
              src={screen.src}
              alt={screen.alt}
              caption={screen.caption}
              size={phoneSize}
            />
          ))}
        </div>
        <p class="text-right text-[9.5px] text-muted">
          <a href={webProjectUrl} class="underline underline-offset-2 hover:text-ink">
            {copy.webDetailLink}
          </a>
        </p>
      </section>
    ) : (
      <section class="flex min-h-0 flex-col justify-between rounded-xl border border-line bg-zinc-50/70 p-4">
        <h2 class="text-[11.5px] font-bold tracking-tight text-ink">{data.modulesTitle}</h2>
        <div class="my-auto grid grid-cols-2 gap-3 py-2">
          {data.modules?.map((mod, idx) => (
            <article class="flex flex-col justify-between rounded-xl border border-line bg-white p-3.5">
              <div>
                <div class="flex items-center justify-between gap-2">
                  <span class="text-[10px] font-bold tabular-nums text-muted">
                    0{idx + 1}
                  </span>
                  <span class="rounded-md border border-line bg-zinc-50 px-1.5 py-0.5 text-[9.5px] font-medium text-ink">
                    {mod.tag}
                  </span>
                </div>
                <h3 class="mt-2 text-[12.5px] font-bold tracking-tight text-ink">
                  {mod.title}
                </h3>
                <p class="mt-1.5 text-[10.5px] leading-[1.55] text-muted">
                  {mod.detail}
                </p>
              </div>
            </article>
          ))}
        </div>
        <div class="flex items-center justify-between border-t border-line pt-2 text-[9.5px] text-muted">
          <span>{stack.join(' · ')}</span>
          <a href={webProjectUrl} class="font-medium text-ink underline underline-offset-2">
            {copy.webDetailLink}
          </a>
        </div>
      </section>
    )}
  </div>
</PdfSheet>
