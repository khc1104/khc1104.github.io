---
import type { Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

interface Props {
  lang: Lang;
  kind: 'profile' | 'detail' | 'summary';
  projectSlug?: string;
  pagePart?: string;
  siteUrl: string;
  class?: string;
}

const { lang, kind, projectSlug, pagePart, siteUrl, class: className } = Astro.props;
const t = useTranslations(lang);
const cleanHost = siteUrl.replace(/^https?:\/\//, '').replace(/\/$/, '');
---

<section
  class:list={[
    'pdf-sheet relative flex flex-col justify-between overflow-hidden bg-white text-ink',
    className,
  ]}
  data-pdf-sheet
  data-kind={kind}
  data-project={projectSlug}
  data-part={pagePart}
>
  <div class="flex min-h-0 flex-1 flex-col">
    <slot />
  </div>

  <footer class="mt-2.5 flex shrink-0 items-center justify-between border-t border-line pt-2 text-[10px] text-muted">
    <span class="font-medium text-ink/80">
      {t('siteName')} · {t('heroTitle')}
    </span>
    <a class="underline-offset-2 hover:text-ink hover:underline" href={siteUrl}>
      {cleanHost}/{lang}/
    </a>
    <span class="font-semibold tabular-nums text-ink/80" data-page-counter>
      01 / 01
    </span>
  </footer>
</section>
