---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import ProfilePhoto from '../../components/ProfilePhoto.astro';
import ContactLinks from '../../components/ContactLinks.astro';
import SkillGroups from '../../components/SkillGroups.astro';
import HistoryList from '../../components/HistoryList.astro';
import { isLang, locales, useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
import { profiles } from '../../data/profile';
import {
  featuredProjects,
  firstScreenshot,
  getProjectsByLang,
  otherProjects,
} from '../../lib/projects';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang: langParam } = Astro.params;

if (!langParam || !isLang(langParam)) {
  return Astro.redirect('/404');
}

const lang: Lang = langParam;
const t = useTranslations(lang);
const profile = profiles[lang];
const projects = await getProjectsByLang(lang);
const featured = featuredProjects(projects);
const others = otherProjects(projects);
const ogSource = featured[0] ?? projects[0];
const ogShot = ogSource ? firstScreenshot(ogSource) : undefined;
---

<BaseLayout
  lang={lang}
  title={`${t('heroTitle')} · ${t('siteName')}`}
  description={profile.intro[0]}
  image={ogShot?.src}
>
  <section
    class="grid gap-8 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-start"
    aria-labelledby="hero-heading"
  >
    <div class="order-2 space-y-5 sm:order-1">
      <div class="space-y-2">
        <h1 id="hero-heading" class="text-3xl font-semibold tracking-tight">{t('siteName')}</h1>
        <p class="text-lg font-medium tracking-tight">{t('heroTitle')}</p>
      </div>
      <div class="max-w-2xl space-y-2 leading-7 text-muted">
        {profile.intro.map((line) => <p>{line}</p>)}
      </div>
      <ContactLinks lang={lang} />
    </div>
    <ProfilePhoto
      class="order-1 sm:order-2"
      alt={t('profilePhotoAlt')}
      monogram={t('siteName').slice(0, 1)}
    />
  </section>

  <section class="mt-16 space-y-4" aria-labelledby="stack-heading">
    <SectionHeader headingId="stack-heading" title={t('stackTitle')} />
    <SkillGroups groups={profile.skills} />
  </section>

  <section id="projects" class="mt-16 scroll-mt-8 space-y-4" aria-labelledby="featured-heading">
    <SectionHeader headingId="featured-heading" title={t('featuredTitle')} />
    <ProjectGrid lang={lang} projects={featured} emptyLabel={t('emptyProjects')} />
  </section>

  {
    others.length > 0 && (
      <section class="mt-16 space-y-4" aria-labelledby="others-heading">
        <SectionHeader headingId="others-heading" title={t('otherProjectsTitle')} />
        <ProjectGrid lang={lang} projects={others} emptyLabel={t('emptyProjects')} />
      </section>
    )
  }

  <section class="mt-16 space-y-6" aria-labelledby="history-heading">
    <SectionHeader headingId="history-heading" title={t('historyTitle')} />
    <HistoryList title={t('experienceTitle')} items={profile.experience} />
    <HistoryList title={t('educationTitle')} items={profile.education} />
    <HistoryList title={t('certificationsTitle')} items={profile.certifications} />
  </section>

  <section class="mt-16 space-y-4" aria-labelledby="contact-heading">
    <SectionHeader headingId="contact-heading" title={t('contactTitle')} />
    <ContactLinks lang={lang} />
  </section>
</BaseLayout>
