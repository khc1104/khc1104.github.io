---
import BaseLayout from '../../layouts/BaseLayout.astro';
import IphoneMockup from '../../components/IphoneMockup.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import TechBadge from '../../components/TechBadge.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import { isLang, locales, useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
import { contact } from '../../data/contact';
import { stackLabels } from '../../data/stack';
import {
  featuredProjects,
  firstScreenshot,
  getProjectsByLang,
  otherProjects,
} from '../../lib/projects';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang: langParam } = Astro.params;

if (!langParam || !isLang(langParam)) {
  return Astro.redirect('/404');
}

const lang: Lang = langParam;
const t = useTranslations(lang);
const projects = await getProjectsByLang(lang);
const featured = featuredProjects(projects);
const others = otherProjects(projects);
const heroSource = featured[0] ?? projects[0];
const heroShot = heroSource ? firstScreenshot(heroSource) : undefined;
---

<BaseLayout lang={lang} title={`${t('heroTitle')} · ${t('siteName')}`}>
  <section
    class="grid items-center gap-10 sm:grid-cols-[minmax(0,1fr)_auto]"
    aria-labelledby="hero-heading"
  >
    <div class="space-y-3">
      <h1 id="hero-heading" class="text-3xl font-semibold tracking-tight">{t('siteName')}</h1>
      <p class="text-lg font-medium tracking-tight">{t('heroTitle')}</p>
      <p class="text-muted">{t('heroBody')}</p>
    </div>
    <IphoneMockup
      alt={heroShot?.alt ?? t('heroMockupAlt')}
      src={heroShot?.src}
    />
  </section>

  <section class="mt-16 space-y-4" aria-labelledby="about-heading">
    <SectionHeader headingId="about-heading" title={t('aboutTitle')} description={t('aboutBody')} />
  </section>

  <section class="mt-16 space-y-4" aria-labelledby="stack-heading">
    <SectionHeader headingId="stack-heading" title={t('stackTitle')} description={t('stackBody')} />
    <div class="flex flex-wrap gap-2">
      {stackLabels.map((label) => <TechBadge label={label} />)}
    </div>
  </section>

  <section id="projects" class="mt-16 space-y-6" aria-labelledby="projects-heading">
    <SectionHeader
      headingId="projects-heading"
      title={t('projectsTitle')}
      description={t('projectsBody')}
    />
    <h3 class="text-lg font-semibold tracking-tight">{t('featuredTitle')}</h3>
    <ProjectGrid
      lang={lang}
      projects={featured}
      emptyLabel={t('emptyProjects')}
      screenshotAlt={t('heroMockupAlt')}
    />
    {
      others.length > 0 && (
        <div class="space-y-4">
          <h3 class="text-lg font-semibold tracking-tight">{t('otherProjectsTitle')}</h3>
          <ProjectGrid
            lang={lang}
            projects={others}
            emptyLabel={t('emptyProjects')}
            screenshotAlt={t('heroMockupAlt')}
          />
        </div>
      )
    }
  </section>

  <section class="mt-16 space-y-4" aria-labelledby="contact-heading">
    <SectionHeader
      headingId="contact-heading"
      title={t('contactTitle')}
      description={t('contactBody')}
    />
    <ul class="space-y-1 text-sm">
      <li>
        <a class="text-ink underline-offset-4 hover:underline" href={contact.github}>
          {t('contactGithub')}
        </a>
      </li>
      <li>
        <a class="text-ink underline-offset-4 hover:underline" href={`mailto:${contact.email}`}>
          {t('contactEmail')} · {contact.email}
        </a>
      </li>
      <li>
        <a class="text-ink underline-offset-4 hover:underline" href={contact.store}>
          {t('contactStore')}
        </a>
      </li>
    </ul>
  </section>
</BaseLayout>
