---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isLang, locales, useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang: langParam } = Astro.params;

if (!langParam || !isLang(langParam)) {
  return Astro.redirect('/404');
}

const lang: Lang = langParam;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={`${t('heroTitle')} · ${t('siteName')}`}>
  <section class="space-y-3" aria-labelledby="hero-heading">
    <h1 id="hero-heading" class="text-3xl font-semibold tracking-tight">{t('heroTitle')}</h1>
    <p class="text-zinc-600">{t('heroBody')}</p>
  </section>

  <section class="mt-12 space-y-3" aria-labelledby="about-heading">
    <h2 id="about-heading" class="text-xl font-semibold">{t('aboutTitle')}</h2>
    <p class="text-zinc-600">{t('aboutBody')}</p>
  </section>

  <section class="mt-12 space-y-3" aria-labelledby="stack-heading">
    <h2 id="stack-heading" class="text-xl font-semibold">{t('stackTitle')}</h2>
    <p class="text-zinc-600">{t('stackBody')}</p>
  </section>

  <section id="projects" class="mt-12 space-y-3" aria-labelledby="projects-heading">
    <h2 id="projects-heading" class="text-xl font-semibold">{t('projectsTitle')}</h2>
    <p class="text-zinc-600">{t('projectsBody')}</p>
  </section>

  <section class="mt-12 space-y-3" aria-labelledby="contact-heading">
    <h2 id="contact-heading" class="text-xl font-semibold">{t('contactTitle')}</h2>
    <p class="text-zinc-600">{t('contactBody')}</p>
  </section>
</BaseLayout>
