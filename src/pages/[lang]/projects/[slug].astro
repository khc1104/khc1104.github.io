---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DevicePreview from '../../../components/DevicePreview.astro';
import TechBadge from '../../../components/TechBadge.astro';
import { isLang, useTranslations } from '../../../i18n/utils';
import type { Lang } from '../../../i18n/ui';
import {
  firstScreenshot,
  getPublishedProjects,
  mockupAltKey,
  platformLabelKey,
  projectLang,
  projectSlug,
} from '../../../lib/projects';

export async function getStaticPaths() {
  const projects = await getPublishedProjects();
  return projects.flatMap((entry) => {
    const lang = projectLang(entry.id);
    const slug = projectSlug(entry.id);
    if (!isLang(lang) || !slug) {
      return [];
    }
    return [{ params: { lang, slug }, props: { entry } }];
  });
}

const { lang: langParam } = Astro.params;
const { entry } = Astro.props;

if (!langParam || !isLang(langParam)) {
  return Astro.redirect('/404');
}

const lang: Lang = langParam;
const t = useTranslations(lang);
const { Content } = await render(entry);
const shot = firstScreenshot(entry);
const listHref = `${getRelativeLocaleUrl(lang, '/')}#projects`;
const { title, summary, period, role, stack, highlights, links, platform } = entry.data;
const isWeb = platform === 'web';
const frameClass = isWeb ? 'w-full max-w-xl' : 'w-40 sm:w-52';
---

<BaseLayout
  lang={lang}
  title={`${title} · ${t('siteName')}`}
  description={summary}
  image={shot?.src}
>
  <p class="mb-8 text-sm">
    <a class="text-muted hover:text-ink" href={listHref}>{t('backToList')}</a>
  </p>

  <article
    class:list={[
      isWeb ? 'space-y-8' : 'grid gap-10 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-start',
    ]}
  >
    {
      isWeb && (
        <DevicePreview
          class={frameClass}
          platform={platform}
          src={shot?.src}
          alt={shot?.alt ?? t(mockupAltKey(platform))}
        />
      )
    }
    <div class="min-w-0 space-y-6">
      <header class="space-y-3">
        <p class="text-xs font-medium tracking-wide text-muted">{t(platformLabelKey(platform))}</p>
        <h1 class="text-3xl font-semibold tracking-tight">{title}</h1>
        <p class="text-muted">{summary}</p>
        <dl class="flex flex-wrap gap-x-6 gap-y-1 text-sm text-muted">
          {
            period && (
              <div>
                <dt class="inline font-medium text-ink">{t('periodLabel')}: </dt>
                <dd class="inline">{period}</dd>
              </div>
            )
          }
          {
            role && (
              <div>
                <dt class="inline font-medium text-ink">{t('roleLabel')}: </dt>
                <dd class="inline">{role}</dd>
              </div>
            )
          }
        </dl>
        <div class="flex flex-wrap gap-1.5">
          {stack.map((label) => <TechBadge label={label} />)}
        </div>
        {
          links && (links.github || links.store || links.demo) && (
            <ul class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
              {links.github && (
                <li>
                  <a class="underline-offset-4 hover:underline" href={links.github}>
                    {t('githubLabel')}
                  </a>
                </li>
              )}
              {links.store && (
                <li>
                  <a class="underline-offset-4 hover:underline" href={links.store}>
                    {t('storeLabel')}
                  </a>
                </li>
              )}
              {links.demo && (
                <li>
                  <a class="underline-offset-4 hover:underline" href={links.demo}>
                    {t('demoLabel')}
                  </a>
                </li>
              )}
            </ul>
          )
        }
      </header>

      {
        highlights && highlights.length > 0 && (
          <section aria-labelledby="highlights-heading">
            <h2 id="highlights-heading" class="text-lg font-semibold">
              {t('highlightsLabel')}
            </h2>
            <ul class="mt-2 list-disc space-y-1 pl-5 text-muted">
              {highlights.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        )
      }

      <div class="project-body text-muted">
        <Content />
      </div>
    </div>

    {
      !isWeb && (
        <DevicePreview
          class={frameClass}
          platform={platform}
          src={shot?.src}
          alt={shot?.alt ?? t(mockupAltKey(platform))}
        />
      )
    }
  </article>
</BaseLayout>

<style>
  .project-body > :global(h2) {
    color: var(--color-ink);
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.35;
    margin-top: 4rem;
    scroll-margin-top: 2rem;
  }

  .project-body > :global(h3) {
    color: var(--color-ink);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.5;
    margin-top: 2.5rem;
    scroll-margin-top: 2rem;
  }

  .project-body > :global(h2 + p),
  .project-body > :global(h3 + p) {
    margin-top: 0.75rem;
  }

  .project-body > :global(ul) {
    list-style: disc;
    margin-top: 1rem;
    padding-left: 1.25rem;
  }

  .project-body > :global(ol) {
    list-style: decimal;
    margin-top: 1rem;
    padding-left: 1.25rem;
  }

  .project-body > :global(p),
  .project-body > :global(:is(ul, ol) > li) {
    line-height: 1.8;
    max-width: 72ch;
  }

  .project-body > :global(p + p) {
    margin-top: 1rem;
  }

  .project-body > :global(:is(ul, ol) > li + li) {
    margin-top: 0.4rem;
  }

  .project-body :global(strong) {
    color: var(--color-ink);
    font-weight: 600;
  }

  .project-body :global(code) {
    border-radius: 0.3rem;
    background: var(--color-zinc-100);
    color: var(--color-ink);
    font-size: 0.875em;
    padding: 0.1rem 0.3rem;
  }

  .project-body > :global(table) {
    display: block;
    margin-top: 1.25rem;
    overflow-x: auto;
    width: 100%;
    font-size: 0.875rem;
    border-collapse: collapse;
    white-space: nowrap;
  }

  .project-body :global(th),
  .project-body :global(td) {
    border-bottom: 1px solid var(--color-line);
    padding: 0.65rem 0.75rem;
    text-align: left;
  }

  .project-body :global(th) {
    color: var(--color-ink);
    font-weight: 600;
  }

  @media (max-width: 639px) {
    .project-body > :global(h2) {
      margin-top: 3rem;
    }
  }
</style>
