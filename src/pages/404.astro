---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n/utils';

const lang = 'ko' as const;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t('notFoundTitle')} description={t('notFoundBody')}>
  <h1 class="text-3xl font-semibold tracking-tight">{t('notFoundTitle')}</h1>
  <p class="mt-3 text-muted">{t('notFoundBody')}</p>
  <p class="mt-6 text-sm">
    <a class="underline-offset-4 hover:underline" href="/ko/">{t('navHome')} (한국어)</a>
    <span class="text-muted"> · </span>
    <a class="underline-offset-4 hover:underline" href="/ja/">ホーム (日本語)</a>
  </p>
</BaseLayout>
