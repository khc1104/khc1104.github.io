---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { pathWithoutLocale, useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  image?: string;
}

const { lang, title, description, image } = Astro.props;
const t = useTranslations(lang);
const pageTitle = title ?? t('siteName');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const localePath = pathWithoutLocale(Astro.url.pathname, lang);
const underLocale =
  Astro.url.pathname === `/${lang}` || Astro.url.pathname.startsWith(`/${lang}/`);
const koHref = new URL(getRelativeLocaleUrl('ko', localePath), Astro.site).href;
const jaHref = new URL(getRelativeLocaleUrl('ja', localePath), Astro.site).href;
const ogLocale = lang === 'ko' ? 'ko_KR' : 'ja_JP';
const ogImage = image
  ? image.startsWith('http')
    ? image
    : new URL(image, Astro.site).href
  : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {
      underLocale && (
        <>
          <link rel="alternate" hreflang="ko" href={koHref} />
          <link rel="alternate" hreflang="ja" href={jaHref} />
          <link rel="alternate" hreflang="x-default" href={koHref} />
        </>
      )
    }
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    {ogImage && <meta property="og:image" content={ogImage} />}
  </head>
  <body class="flex min-h-screen flex-col bg-paper text-ink antialiased">
    <Header lang={lang} />
    <main class="mx-auto w-full max-w-5xl flex-1 px-4 py-10">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
