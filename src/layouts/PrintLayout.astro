---
import type { Lang } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  lang: Lang;
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      (function () {
        function prepare(img) {
          if (img.dataset.printReady) return;
          img.dataset.printReady = '1';
          img.loading = 'eager';
          var picture = img.closest('picture');
          var source = picture && picture.querySelector('source[srcset]');
          if (source) img.src = source.getAttribute('srcset');
        }
        function openDetails(node) {
          if (node.tagName === 'DETAILS') node.open = true;
          if (node.querySelectorAll) {
            node.querySelectorAll('details').forEach(function (item) {
              item.open = true;
            });
          }
        }
        new MutationObserver(function (records) {
          records.forEach(function (record) {
            record.addedNodes.forEach(function (node) {
              if (!node || node.nodeType !== 1) return;
              openDetails(node);
              if (node.tagName === 'IMG') prepare(node);
              if (node.querySelectorAll) node.querySelectorAll('img').forEach(prepare);
            });
          });
        }).observe(document.documentElement, { childList: true, subtree: true });
      })();
    </script>
  </head>
  <body class="print-doc bg-white text-ink antialiased">
    <slot />
    <script is:inline>
      document.querySelectorAll('details').forEach(function (item) {
        item.open = true;
      });
      document.querySelectorAll('article.project-sheet').forEach(function (sheet) {
        function demote(from, to) {
          sheet.querySelectorAll('.project-body ' + from).forEach(function (heading) {
            var next = document.createElement(to);
            next.id = heading.id;
            next.innerHTML = heading.innerHTML;
            heading.replaceWith(next);
          });
        }
        demote('h3', 'h4');
        demote('h2', 'h3');
        var slug = sheet.id;
        var ids = new Map();
        sheet.querySelectorAll('[id]').forEach(function (el) {
          if (el === sheet || el.id.indexOf(slug + '-') === 0) return;
          var nextId = slug + '--' + el.id;
          ids.set(el.id, nextId);
          el.id = nextId;
        });
        sheet.querySelectorAll('a[href^="#"]').forEach(function (link) {
          var hash = link.getAttribute('href').slice(1);
          if (ids.has(hash)) link.setAttribute('href', '#' + ids.get(hash));
        });
      });
    </script>
  </body>
</html>

<style is:global>
  .print-doc {
    margin: 0 auto;
    max-width: 42rem;
    padding: 2rem 1.25rem 4rem;
    background: white;
    color: var(--color-ink);
    font-size: 11pt;
    line-height: 1.65;
  }

  .print-doc h1 {
    font-size: 22pt;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .print-doc h2 {
    margin-top: 1.75rem;
    font-size: 15pt;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.35;
    break-after: avoid;
  }

  .print-doc .project-sheet > header > h2 {
    margin-top: 0.15rem;
  }

  .print-doc .project-body h3 {
    margin-top: 1.6rem;
    color: var(--color-ink);
    font-size: 13pt;
    font-weight: 600;
    line-height: 1.4;
    break-after: avoid;
  }

  .print-doc .project-body h4 {
    margin-top: 1.1rem;
    color: var(--color-ink);
    font-size: 11.5pt;
    font-weight: 600;
    line-height: 1.45;
    break-after: avoid;
  }

  .print-doc .project-body p,
  .print-doc .project-body li {
    max-width: 68ch;
    line-height: 1.7;
  }

  .print-doc .project-body p + p,
  .print-doc .project-body :is(ul, ol, table) + p,
  .print-doc .project-body :is(ul, ol) {
    margin-top: 0.9rem;
  }

  .print-doc .project-body ul {
    list-style: disc;
    padding-left: 1.25rem;
  }

  .print-doc .project-body ol {
    list-style: decimal;
    padding-left: 1.25rem;
  }

  .print-doc .project-body strong {
    color: var(--color-ink);
    font-weight: 600;
  }

  .print-doc .project-body table {
    display: table;
    width: 100%;
    margin-top: 0.9rem;
    border-collapse: collapse;
    font-size: 9.5pt;
    white-space: normal;
  }

  .print-doc .project-body th,
  .print-doc .project-body td {
    border-bottom: 1px solid var(--color-line);
    padding: 0.4rem 0.5rem;
    text-align: left;
    white-space: normal;
  }

  .print-doc .project-body th {
    color: var(--color-ink);
    font-weight: 600;
  }

  .print-doc figure ul {
    flex-wrap: wrap;
    overflow: visible;
  }

  .print-doc figure li,
  .print-doc aside,
  .print-doc details,
  .print-doc figure img {
    break-inside: avoid;
  }

  .print-doc .iphone-mockup,
  .print-doc .iphone-mockup__bezel {
    box-shadow: none !important;
  }

  .print-doc a.print-url {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
    word-break: break-all;
  }

  .print-doc a.print-url::after {
    content: ' (' attr(href) ')';
    font-weight: 400;
  }

  .project-sheet,
  .history-sheet {
    break-before: page;
  }

  @page {
    size: A4;
    margin: 14mm 15mm 16mm;

    @bottom-center {
      content: counter(page);
      font-family: system-ui, sans-serif;
      font-size: 9pt;
      color: #3f3f46;
    }
  }

  @media print {
    .print-doc {
      max-width: none;
      padding: 0;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    .print-doc details summary span[aria-hidden='true'] {
      display: none;
    }
  }
</style>
